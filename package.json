{
  "name": "storefont",
  "version": "1.0.0",
  "description": "InSales icon fonts (insales-icons) generated from 3 free SVG icon sets, with a Vite demo for GitHub Pages",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "fonts": "node scripts/build-fonts.mjs",
    "dev": "vite",
    "build": "npm run fonts && vite build",
    "build:site": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@phosphor-icons/core": "^2.1.1",
    "bootstrap-icons": "^1.13.1",
    "eslint": "^10.11.0",
    "fantasticon": "^4.1.0",
    "globals": "^17.12.0",
    "remixicon": "^4.9.1",
    "vite": "^8.3.0",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
